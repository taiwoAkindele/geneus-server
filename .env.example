# Copy to .env for local development. Never commit .env.
# CouchDB admin — the server uses this only to provision facility databases.
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=devpassword

# URL the PWA replicates against. Same as COUCHDB_URL in local development;
# in production this is the public CouchDB host. It is handed to every device
# at registration and stored there, so a wrong value is only discovered when a
# facility in the field cannot sync.
COUCHDB_PUBLIC_URL=http://127.0.0.1:5984

# Origins allowed to call this server, comma-separated. Also pushed into
# CouchDB's own CORS configuration at every boot, since the PWA replicates
# against CouchDB directly from the browser.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PORT=8080

# Set to "production" outside development. It switches logging from
# pino-pretty (a dev dependency) to raw JSON on stdout.
# NODE_ENV=production

# Ed25519 private key (PKCS#8, base64) used to sign rosters and /time.
# Left unset in development, the server generates an ephemeral key at boot and
# logs the public key. Production must supply one from the secret store —
# generate it with: node scripts/generate-signing-key.ts
# SIGNING_PRIVATE_KEY=
