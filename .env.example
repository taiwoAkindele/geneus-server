# Copy to .env for local development. Never commit .env.

# PostgreSQL — the source of truth. The local compose file publishes it on 5433.
POSTGRES_URL=postgres://geneus:devpassword@127.0.0.1:5433/geneus

# Where devices connect PowerSync to. Handed to every device at enrollment and
# stored there, so it must be the address DEVICES can reach — never an internal
# one. The service itself arrives in Phase D; until then this is a placeholder.
POWERSYNC_PUBLIC_URL=http://127.0.0.1:8090

# The `aud` claim geneus-server puts in sync tokens; the PowerSync service's
# client_auth.audience must list the same value. Tokens live an hour by default
# (PowerSync caps this at 24 hours); a device only needs one while online.
POWERSYNC_JWT_AUDIENCE=powersync
SYNC_TOKEN_TTL_SECONDS=3600

# Origins allowed to call this server, comma-separated.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PORT=8080

# Set to "production" outside development. It switches logging from
# pino-pretty (a dev dependency) to raw JSON on stdout, and makes
# SIGNING_PRIVATE_KEY mandatory.
# NODE_ENV=production

# Ed25519 private key (PKCS#8, base64) used to sign rosters and /time.
# Left unset in development, the server generates an ephemeral key at boot.
# Production refuses to start without one — generate it with:
#   node scripts/generate-signing-key.ts
# SIGNING_PRIVATE_KEY=

# --- Legacy (removed in Phase F) ------------------------------------------
# Only the CouchDB test suites still read these; the server does not.
# COUCHDB_URL=http://127.0.0.1:5984
# COUCHDB_USER=admin
# COUCHDB_PASSWORD=devpassword
