# Copy to .env for local development. Never commit .env.
# CouchDB admin — the server uses this only to provision facility databases.
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=devpassword

# URL the PWA replicates against. Same as COUCHDB_URL in local development;
# in production this is the public CouchDB host.
COUCHDB_PUBLIC_URL=http://127.0.0.1:5984

PORT=8080

# Ed25519 private key (PKCS#8, base64) used to sign rosters and /time.
# Left unset in development, the server generates an ephemeral key at boot and
# logs the public key. Production must supply one from the secret store.
# SIGNING_PRIVATE_KEY=
