{
  "name": "geneus-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared": "./shared/src/index.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "invite": "node --env-file-if-exists=.env scripts/create-invite.ts",
    "key:generate": "node --env-file-if-exists=.env scripts/generate-signing-key.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:sync": "node --env-file-if-exists=.env --test tests/powersync.integration.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "sync:up": "docker compose up -d postgres powersync",
    "sync:down": "docker compose stop powersync",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "sync:config": "node --env-file-if-exists=.env scripts/generate-sync-config.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.2"
  }
}
